# Server Configuration
PORT=5500

# Database Configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=youruser
DATABASE_PASS=yourpass
DATABASE_NAME=yourdb

# Session Secret (generate a strong random string)
SESSION_SECRET=your-secure-random-session-secret-here

# Google OAuth Credentials (required - generate from Google Cloud Console)
# See: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5500/api/auth/google/callback

# AI Backend Configuration
AI_BACKEND_URL=http://127.0.0.1:8000/api/chat
AI_BACKEND_TIMEOUT_MS=300000

# Optional: OpenAI API Key (if using OpenAI for chat)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: LLM Call Timeout in seconds
# LLM_CALL_TIMEOUT_S=180
